      "signals": [
        {"id": "LR4_RIDE_HEIGHT_STATE", "name": "Ride height state", "description": "Runs in parallel with the ride height mode PID and agrees with it. All three observed bits are measured against the front height sensor: 0x100 at a front reading around 110 (Normal), 0x400 around 85 with the truck at its highest (Off-Road), 0x800 at 133 with it at its lowest (Access). Remember the sensor is inverted. Bit 9 (0x200) sits between Normal and Off-Road and has never been seen in 142 samples; the held-Access mode, where the lower button is held and the truck stays down, is the obvious candidate and has never been captured.", "group": "Suspension", "bit": 0, "bits": 32, "values": {"256": "Normal", "1024": "Off-Road", "2048": "Access"}, "valueDescriptions": {"256": "Normal", "1024": "Off-Road", "2048": "Access"}}
